group_by(Hours, Strain) %>%
summarize(mean = mean(OD), sd = sd(OD), n=n(), se = sd/sqrt(n)) %>%
group_by(Strain)
dU_GC_tidy_Stat %>%
ggplot(aes(x = Hours, y = mean, color=Strain)) +
geom_line()
